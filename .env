# Environment
ENVIRONMENT=production
LOG_LEVEL=info

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LLM Configuration - GROQ (Updated)
LLM_PROVIDER=groq
GROQ_API_KEY=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  # Replace with your key!
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Model Configuration
CLAIM_DETECTOR_MODEL=en_core_web_sm
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_SEQUENCE_LENGTH=512

# Google Fact Check API
GOOGLE_FACT_CHECK_API_KEY=AIzaSyChZLDu7zfXmp_TMbSmEPHjcNflLRsOpy0

# Fact Check Source Enabled/Disabled
GOOGLE_FACT_CHECK_ENABLED=true
SNOPES_ENABLED=true
GDELT_ENABLED=true

# Evidence Retrieval - ALL FREE SOURCES
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
COMMONCRAWL_API_URL=https://index.commoncrawl.org/CC-MAIN-2024-10-index
MAX_EVIDENCE_PER_CLAIM=10
EVIDENCE_TIMEOUT=30
REQUEST_DELAY=1.0

# FAISS Configuration
FAISS_INDEX_PATH=./data/models/faiss_index
TOP_K_EVIDENCE=5

# Redis Cache (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=3600

# Aggregation
SOURCE_WEIGHTS={"reuters": 1.0, "ap": 1.0, "bbc": 0.9, "nyt": 0.9, "cnn": 0.8, "fox": 0.8, "twitter": 0.3}
TIME_DECAY_DAYS=30
VERDICT_THRESHOLD=0.3

# Explainability
SHAP_NUM_SAMPLES=100
LIME_NUM_FEATURES=10
GENERATE_HTML_REPORT=true
ENABLE_LLM_EXPLANATIONS=true

# LangChain Configuration (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fake-news-detection

# Paths
DATA_DIR=./data
CACHE_DIR=./data/cache
MODEL_DIR=./data/models
OUTPUT_DIR=./outputs
LOG_DIR=./outputs/logs